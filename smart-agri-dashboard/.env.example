# Local hardware
DISABLE_AUTH=true
LOCAL_SERIAL_CONTROL=true
SERIAL_PORT=
SERIAL_BAUD=9600

# Azure Cosmos DB and Functions
COSMOS_CONNECTION_STRING=
COSMOS_DATABASE=soil-agri
AZURE_FUNCTION_BASE_URL=
AZURE_FUNCTION_KEY=

# Azure Maps weather
AZURE_MAPS_KEY=

# Azure OpenAI recommendations
SOIL_AZURE_OPENAI_ENDPOINT=
SOIL_AZURE_OPENAI_API_KEY=
SOIL_AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano

# Azure Communication Services
AZURE_COMMUNICATION_CONNECTION_STRING=
ACS_EMAIL_SENDER=
ALERT_EMAIL_TO=
ACS_SMS_FROM=
ALERT_PHONE_TO=

# Polygon Amoy telemetry anchoring (used by Azure Functions)
BLOCKCHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
